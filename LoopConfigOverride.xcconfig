// Optional machine-level override, kept outside the checkout so git can never
// clobber it and your team id can never be committed.
//
// Xcode resolves these paths relative to the PRIMARY xcconfig (Loop/Loop.xcconfig),
// not relative to this file, so each hop is measured from the Loop/ directory:
//   ../..     -> the workspace's parent   (reaches ~ for ~/LoopWorkspace)
//   ../../..  -> one level above that     (reaches ~ for ~/projects/LoopWorkspace)
// Listing several depths makes ~/LoopConfigOverride.xcconfig work no matter how
// deep the workspace is cloned. Do NOT add a bare "../" hop: from Loop/ that
// resolves to this very file and self-includes.
//
// Later includes win, so the file nearest the workspace takes precedence.
#include? "../../../../LoopConfigOverride.xcconfig"
#include? "../../../LoopConfigOverride.xcconfig"
#include? "../../LoopConfigOverride.xcconfig"

// Override this if you don't want the default com.${DEVELOPMENT_TEAM}.loopkit that loop uses
// MAIN_APP_BUNDLE_IDENTIFIER = com.myname.loop

// Customize this to change the app name displayed
//MAIN_APP_DISPLAY_NAME = Loop

// Customize this to change the URL to open Loop to something other than the display name
//URL_SCHEME_NAME = $(MAIN_APP_DISPLAY_NAME)

// Features
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) SIMULATORS_ENABLED OBSERVE_HEALTH_KIT_CARB_SAMPLES_FROM_OTHER_APPS_ENABLED //DEBUG_FEATURES_ENABLED


// Put your team id here for signing
//LOOP_DEVELOPMENT_TEAM = UY678SP37Q
